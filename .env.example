# Generate distinct secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SPA_BIND_IP=127.0.0.1
SPA_PORT=18473
COOKIE_SECURE=true
# Comma-separated trusted reverse proxy addresses; empty trusts none.
TRUSTED_PROXY_IPS=
BARK_SERVER_URL=https://api.day.app
# Optional SQLite service memory cap, for example 256m. 0 leaves it unlimited.
SPA_MEMORY_LIMIT=0
# Optional when using compose.mariadb.yaml:
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# Optional when using compose.external-db.yaml:
# DATABASE_URL=mysql+pymysql://spa:password@db-host:3306/spa?charset=utf8mb4
