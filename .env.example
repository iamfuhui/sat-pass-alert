# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Use URL-safe random passwords here; URL-encode special characters in DATABASE_URL.
DB_PASSWORD=
DB_ROOT_PASSWORD=
SPA_BIND_IP=0.0.0.0
SPA_PORT=18473
COOKIE_SECURE=false
# Comma-separated trusted reverse proxy addresses; empty trusts none. Never use * publicly.
TRUSTED_PROXY_IPS=
BARK_SERVER_URL=https://api.day.app
# For compose.external-db.yaml only:
DATABASE_URL=mysql+pymysql://spa:password@db-host:3306/spa?charset=utf8mb4
